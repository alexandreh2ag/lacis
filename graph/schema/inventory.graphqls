"The projects and envs filters take slugs; search matches names case-insensitively."
input HostFilter {
  projects: [String!]
  envs: [String!]
  status: [HostStatus!]
  search: String
}

input AppFilter {
  projects: [String!]
  envs: [String!]
  search: String
  "A framework, as collected (symfony, laravel…), and its version."
  framework: VersionConstraint
  "A runtime (php, node…) and its version."
  runtime: VersionConstraint
}

"""
A framework or a runtime, and a version it compares to, part by part: 7.10 is above 7.9. The
version of an app is cut to the parts given, so that EQ 7.4 takes 7.4.33 and GT 7.4 starts at
7.5. No version takes every version.
"""
input VersionConstraint {
  name: String!
  op: VersionOp = GTE
  version: String
}

enum VersionOp {
  LT
  LTE
  EQ
  GTE
  GT
}

"What the inventory of a namespace holds, to filter by."
type Facets {
  frameworks: [VersionFacet!]!
  runtimes: [VersionFacet!]!
  serviceTypes: [String!]!
  webserverTypes: [String!]!
  "The services and the webservers by type, with the versions they run."
  components: [VersionFacet!]!
}

"A framework or a runtime the apps use, or a type of service or webserver."
type VersionFacet {
  name: String!
  "The versions in use, as major.minor, in order."
  versions: [String!]!
}

input ServiceFilter {
  types: [String!]
  projects: [String!]
  envs: [String!]
  search: String
}

enum HostStatus {
  ACTIVE
  "No snapshot for longer than the staleAfter of the namespace."
  STALE
  "No snapshot for longer than its inactiveAfter."
  INACTIVE
}

type HostList {
  items: [Host!]!
  total: Int!
}

type AppList {
  items: [App!]!
  total: Int!
}

type ServiceList {
  items: [Service!]!
  total: Int!
}

"A service or a webserver of a host."
union Component = Service | Webserver

enum ComponentKind {
  SERVICE
  WEBSERVER
}

"Search matches the type, the instance, the version, the hostname and, for a webserver, its domains."
input ComponentFilter {
  kinds: [ComponentKind!]
  types: [String!]
  projects: [String!]
  envs: [String!]
  search: String
  "A type of service or webserver (mysql, nginx…) and its version."
  version: VersionConstraint
}

type ComponentList {
  items: [Component!]!
  total: Int!
}

type Host {
  id: ID!
  hostname: String!
  project: Project
  environment: Environment
  """
  The projects and envs the host hosts: those of its labels first, then
  those of its apps, which may name others.
  """
  places: [Place!]!
  status: HostStatus!
  os: OS
  kernel: String
  arch: String
  virtualization: String
  "CPU, memory and disks, as collected."
  resources: JSON
  agentVersion: String
  firstSeenAt: Time!
  lastSeenAt: Time!
  ips: [HostIP!]!
  runtimes: [Runtime!]!
  "The Docker containers of the host, running or not, by name."
  containers: [Container!]!
  services: [Service!]!
  webservers: [Webserver!]!
  apps: [App!]!
  history(page: PageInput): ChangeEventList!
}

"A project and an env; either may be unknown."
type Place {
  project: Project
  environment: Environment
}

type OS {
  id: String!
  version: String
  pretty: String
}

type HostIP {
  address: String!
  prefixLength: Int!
  interface: String
  defaultRoute: Boolean!
  network: Network
}

type Runtime {
  id: ID!
  type: String!
  version: String!
  path: String!
  manager: String
  """
  The version of the system package holding the runtime, its packaging
  revision included (8.1.34-9+deb.sury.org+1): distributions patch an
  end-of-life version there and keep the version.
  """
  packageVersion: String
  firstSeenAt: Time!
}

"A Docker container of a host. Its environment is never collected."
type Container {
  id: ID!
  name: String!
  "The short id Docker gives the container."
  containerId: String!
  image: String!
  "The version of the image: its tag when it is one, else its OCI version label."
  version: String
  "running, exited, paused, restarting, created, removing or dead."
  state: String!
  "host:port->port/proto when published, else port/proto."
  ports: [String!]!
  networks: [String!]!
  composeProject: String
  composeService: String
  firstSeenAt: Time!
}

type Service {
  id: ID!
  type: String!
  instance: String!
  version: String
  "The version of the system package of the service, its packaging revision included."
  packageVersion: String
  "Listen addresses, config path, cluster, pools or container."
  details: JSON
  host: Host!
  "The projects and envs it serves: those of its host, then those of the apps of its host that use it."
  places: [Place!]!
  firstSeenAt: Time!
  "The links to the service."
  dependents: [Link!]!
  "Who uses the service, through the proxies in between, once per app whatever its hosts."
  usedBy: [AppLink!]!
}

type Webserver {
  id: ID!
  type: String!
  version: String
  host: Host!
  "The projects and envs it serves: those of its host, then those of the apps of its host it serves."
  places: [Place!]!
  "The domains it serves."
  domains: [String!]!
  "Its vhosts, routers, services, frontends and backends, as collected."
  routing: JSON
  firstSeenAt: Time!
  "The links to the webserver, from the proxies in front of it."
  dependents: [Link!]!
  "The links from the webserver, to the apps it serves and the backends it routes to."
  links: [Link!]!
  "Who uses the webserver for a name its routes lead nowhere known with: the routes ending at it."
  usedBy: [AppLink!]!
}

type App {
  id: ID!
  name: String!
  path: String!
  resolvedPath: String
  role: String!
  project: Project
  environment: Environment
  framework: String
  frameworkVersion: String
  runtime: AppRuntime
  code: AppCode
  vhosts: [String!]!
  launchers: JSON
  info: JSON
  host: Host!
  firstSeenAt: Time!
  dependencies: [Dependency!]!
  "The links from the app."
  links: [Link!]!
  "The links to the app, from the webservers serving it."
  dependents: [Link!]!
  "The deployments of the app in its project and env, itself included, by hostname; itself alone without project or env."
  deployments: [App!]!
  "What the app uses, through the proxies in between, all its deployments together."
  uses: [AppLink!]!
  "Who uses the app, through the proxies in between, all its deployments together."
  usedBy: [AppLink!]!
}

type AppRuntime {
  type: String!
  version: String!
  "The version of the system package of the runtime or of its PHP-FPM, its packaging revision included."
  packageVersion: String
  path: String
  source: String
}

"The code deployed: from a deploy info file or the git repository."
type AppCode {
  source: String!
  version: String
  commit: String
  branch: String
  tag: String
  repository: String
  pipelineId: String
  pipelineUrl: String
  deployedAt: Time
  deployedBy: String
}

"A dependency read in the configuration of an app, the secrets left out."
type Dependency {
  key: String!
  scheme: String
  port: Int
  path: String
  "The hosts, IPs or socket it targets."
  target: JSON
  "Where it was read."
  source: JSON
  unparsed: Boolean!
}

enum LinkConfidence {
  EXACT
  INFERRED
  AMBIGUOUS
}

type Link {
  id: ID!
  "env, traefik, webserver, launcher or process."
  source: String!
  confidence: LinkConfidence!
  "How it was resolved: socket, loopback, route, hostname, private_ip, public_ip, vhost…"
  rule: String!
  "Why a target is external: cdn, public_ip, unknown_private_ip, dns_failed…"
  reason: String
  "The dependency it comes from."
  key: String
  from: LinkEnd!
  to: LinkEnd!
  "Everything known of the resolution."
  detail: JSON!
  computedAt: Time!
}

union LinkEnd = App | Service | Webserver | Host | External

"""
What an app uses through the proxies in between, whatever the hosts: the effective links of
one consumer (an app of a project and an env), one dependency and one thing used (an app, a
service or a webserver of a project and an env, a host, an external target), merged.
"""
type AppLink {
  "Its id, for linkRoutes."
  id: String!
  "One of the deployments of the consumer."
  from: LinkEnd!
  "One of the ends of what is used."
  to: LinkEnd!
  "The dependency the links start from."
  key: String
  "The weakest confidence of the links crossed."
  confidence: LinkConfidence!
  "A route ends at a webserver whose routes lead nowhere known for the name called."
  deadEnd: Boolean!
  "How the first link of the routes was resolved: rule, reason and CDN."
  resolvedBy: [String!]!
  "The webservers a route crosses, in order, by type; none when no route crosses one."
  via: [String!]!
  "The routes, step by step: what linkRoutes gives."
  routes: [LinkRoute!]!
}

"A route of an effective link, read from the consumer to what it uses."
type LinkRoute {
  steps: [RouteStep!]!
}

"A node of a route, whatever its hosts, and how the link before it was resolved."
type RouteStep {
  "One of the ends standing for the node."
  node: LinkEnd!
  "The hostnames of the node."
  hosts: [String!]!
  "How the link reaching the node was resolved; none for the consumer."
  rule: String
  confidence: LinkConfidence
  "The dependency (key = target) for the first link, the routes of a webserver after."
  details: [String!]!
  "The domains a webserver routes the name called with."
  names: [String!]!
}

"A target out of the namespace, or one the resolution could not place."
type External {
  target: String!
  reason: String
}

"The order of a listing; ties are broken by name."
input HostSort {
  by: HostSortField!
  desc: Boolean = false
}

enum HostSortField {
  HOSTNAME
  PROJECT
  ENV
  "The address of the default route, else the first."
  IP
  OS
  APPS
  "Freshest first."
  STATUS
  LAST_SEEN
}

input AppSort {
  by: AppSortField!
  desc: Boolean = false
}

enum AppSortField {
  NAME
  PROJECT
  ENV
  HOSTNAME
  "The code deployed: tag or branch."
  VERSION
  FRAMEWORK
}

input ServiceSort {
  by: ServiceSortField!
  desc: Boolean = false
}

enum ServiceSortField {
  TYPE
  VERSION
  HOSTNAME
}
