type Namespace {
  id: ID!
  slug: String!
  name: String!
  description: String
  "Seconds without snapshot after which a host is stale, then inactive."
  staleAfter: Int!
  inactiveAfter: Int!
  "Seconds the snapshots are kept."
  snapshotRetention: Int!
  "Whether the user may change the metadata of the namespace."
  canEdit: Boolean!
  counts: NamespaceCounts!
  facets: Facets!
  projects: [Project!]!
  environments: [Environment!]!
  networks: [Network!]!

  hosts(filter: HostFilter, sort: HostSort, page: PageInput): HostList!
  host(id: ID!): Host
  """
  The apps. With merge, one app per name, project and env, whatever the hosts it is
  deployed on: the first in the order stands for the others, its deployments listing them
  all; an app without project or env is not merged.
  """
  apps(filter: AppFilter, sort: AppSort, page: PageInput, merge: Boolean = false): AppList!
  app(id: ID!): App
  "The routes of app links, by their ids, merged."
  linkRoutes(ids: [String!]!): [LinkRoute!]!
  services(filter: ServiceFilter, sort: ServiceSort, page: PageInput): ServiceList!
  service(id: ID!): Service
  "The services and the webservers of the hosts, in one listing."
  components(filter: ComponentFilter, sort: ServiceSort, page: PageInput): ComponentList!
  webserver(id: ID!): Webserver
  history(filter: HistoryFilter, page: PageInput): ChangeEventList!
}

type NamespaceCounts {
  projects: Int!
  environments: Int!
  hosts: Int!
  "Hosts without snapshot for longer than staleAfter, but not inactiveAfter."
  staleHosts: Int!
  "Hosts without snapshot for longer than inactiveAfter."
  inactiveHosts: Int!
  apps: Int!
  webservers: Int!
  services: Int!
  links: Int!
  "Links to a target out of the namespace or not resolved."
  externalLinks: Int!
}

type Project {
  id: ID!
  slug: String!
  name: String!
  description: String
  "What still names the project: it is deleted only once nothing does."
  usage: CatalogUsage!
  "The envs of its apps and of its hosts, by their labels or by the apps they run."
  envs: [Environment!]!
  "The other projects its apps use, through the proxies."
  dependsOn: [Project!]!
  "Whether its apps use a target out of the inventory."
  usesExternals: Boolean!
  "Its apps once per name and env, whatever the hosts they are deployed on."
  appCount: Int!
}

type Environment {
  id: ID!
  slug: String!
  name: String!
  sortOrder: Int!
  "What still names the env: it is deleted only once nothing does."
  usage: CatalogUsage!
}

"The hosts and the apps (removed ones aside) naming a project or an env."
type CatalogUsage {
  hosts: Int!
  apps: Int!
}

type Network {
  id: ID!
  slug: String!
  name: String!
  kind: String!
  description: String
  "The ranges of the network; a network split from another shares its ranges."
  cidrs: [String!]!
  "The network this one was split from by hand: two networks on the same range."
  splitFrom: Network
  "The hosts with an IP in the network, by hostname."
  hosts: [Host!]!
}
